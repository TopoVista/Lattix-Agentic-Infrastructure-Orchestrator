flowchart TB
  Internet[Internet]
  DNS[Route 53 / DNS]
  CDN[CloudFront / CDN]
  ALB[Application Load Balancer]

  subgraph VPC[AWS VPC]
    subgraph Public[Public Subnets]
      NAT[NAT Gateway]
      ALB
    end

    subgraph Private[Private App Subnets]
