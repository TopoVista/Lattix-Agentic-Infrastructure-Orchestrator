      Workers[Worker Pods]
    end

    subgraph Data[Private Data Subnets]
      RDS[(RDS PostgreSQL)]
      Redis[(ElastiCache Redis)]
      Kafka[(MSK / Kafka)]
    end
  end

  S3[(S3 Buckets)]
  ECR[(ECR)]
  KMS[KMS]
  Secrets[Secrets Manager]
  CloudWatch[CloudWatch]

  Internet --> DNS
  DNS --> CDN
  CDN --> ALB
  ALB --> Gateway
  Gateway --> Services
  Services --> RDS
  Services --> Redis
  Services --> Kafka
  Agents --> Services
